# Database connection string (PostgreSQL with psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/portfolio_risk

# Risk engine defaults
RISK_FREE_RATE=0.0
TRADING_DAYS_PER_YEAR=252
DEFAULT_CONFIDENCE=0.95

# Application configuration
APP_ENV=development
LOG_LEVEL=INFO
